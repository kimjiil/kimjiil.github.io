---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import LocalGraph from "../../components/LocalGraph.astro";
import { CATEGORIES, SECTIONS } from "../../consts";
import { buildLocalGraphData } from "../../lib/graphData";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.split("/").pop()! },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const slug = post.id.split("/").pop()!;
const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const localGraph = buildLocalGraphData(allPosts, slug);

const cat = CATEGORIES[post.data.category];
const section = cat ? SECTIONS[cat.section] : undefined;
const sectionHref = cat ? `/${cat.section}` : "/";
const dateStr = post.data.date.toISOString().slice(0, 10);
const updatedStr = post.data.updated?.toISOString().slice(0, 10);
const tocHeadings = headings.filter((h) => h.depth <= 4);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="post-page">
    <div class="container post-container">
      <div class="post-grid">
        <div class="post-main">
          <!-- Hero Header -->
          <header class="post-header">
            <div class="post-badges">
              {section && <a href={sectionHref} class="badge">{section.title}</a>}
              {cat && <span class="badge cat-badge">{cat.label}</span>}
            </div>
            <h1 class="post-title">{post.data.title}</h1>
            <div class="post-meta-grid">
              <div class="meta-item">
                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                  ></path>
                </svg>
                <div>
                  <span class="meta-label">작성일</span>
                  <span class="meta-value">{dateStr}</span>
                </div>
              </div>
              {
                updatedStr && (
                  <div class="meta-item">
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                      ></path>
                    </svg>
                    <div>
                      <span class="meta-label">수정일</span>
                      <span class="meta-value">{updatedStr}</span>
                    </div>
                  </div>
                )
              }
            </div>
          </header>

          <!-- Main Content -->
          <section class="post-content">
            <div class="prose">
              <Content />
            </div>
          </section>

          <!-- Tags -->
          {
            post.data.tags.length > 0 && (
              <div class="post-tags">
                {post.data.tags.map((t) => (
                  <a href={`/tags#${encodeURIComponent(t)}`} class="tag">
                    #{t}
                  </a>
                ))}
              </div>
            )
          }

          <!-- Back Button -->
          <div class="back-link">
            <a href={sectionHref}>
              <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
              </svg>
              목록으로 돌아가기
            </a>
          </div>
        </div>

        <!-- Right Sidebar: TOC + Local Graph -->
        <aside class="post-side">
          <div class="side-sticky">
            {tocHeadings.length > 0 && <TableOfContents headings={tocHeadings} />}
            <LocalGraph data={localGraph} centerId={`p:${slug}`} />
          </div>
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .post-page {
    padding: 3rem 0 5rem;
  }

  .post-container {
    max-width: 1240px;
  }

  .post-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 2.5rem;
    /* align-items 기본값(stretch) 유지 필수:
       사이드바 컬럼이 본문 전체 높이로 늘어나야 그 안의 sticky가 스크롤을 따라 이동할 수 있다 */
  }

  .post-main {
    min-width: 0;
    max-width: 860px;
    margin: 0 auto;
    width: 100%;
  }

  .post-side {
    min-width: 0;
  }

  .side-sticky {
    position: sticky;
    top: 88px;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .post-header {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-xl);
    padding: 2.5rem;
    margin-bottom: 2.5rem;
  }

  .post-badges {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .cat-badge {
    background: var(--color-bg-tertiary);
    color: var(--color-green);
    border-color: #4ade8033;
  }

  .post-title {
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    line-height: 1.35;
    color: var(--color-text-primary);
    margin: 0 0 1.5rem;
    word-break: keep-all;
  }

  .post-meta-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-accent);
  }

  .meta-item > div {
    display: flex;
    flex-direction: column;
  }

  .meta-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  .meta-value {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border-light);
  }

  .back-link {
    margin-top: 2rem;
  }

  .back-link a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .back-link a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 1024px) {
    .post-grid {
      grid-template-columns: 1fr;
    }

    /* 모바일/태블릿: 사이드바는 본문 아래에 그래프만 표시 */
    .post-side {
      order: 2;
    }

    .side-sticky {
      position: static;
    }
  }

  @media (max-width: 768px) {
    .post-header {
      padding: 1.5rem;
    }
  }
</style>
