---
import BaseLayout from "../layouts/BaseLayout.astro";
import { GITHUB_URL, EMAIL } from "../consts";

const skills = {
  Work: ["Python", "C/C++", "PyTorch", "TensorFlow", "Java", "Pandas", "MatLab", "OpenCV", "CUDA", "TensorRT"],
  Study: ["Verilog", "HTML/CSS", "Unreal Engine", "Arduino", "Kubernetes", "Docker"],
  Etc: ["Linux/Ubuntu", "Git / Github", "Vim", "Wandb.ai", "Markdown"],
};

const experiences = [
  {
    period: "2023. 12 ~ 2024. 05",
    duration: "5개월",
    name: "시스윈 로보틱스",
    role: "대리 (AI 연구/개발)",
    desc: "AMR(자율 이동 로봇) 개발 업체 — 딥러닝 기반 SLAM/Localization 연구",
    items: [
      "AMR의 SLAM을 딥러닝으로 수행하기 위한 기술 리서치 및 연구",
      "LiDAR 포인트 클라우드 기반 end-to-end 위치 추정 모델 PointLoc 구현 및 실험",
    ],
    keywords: ["Python", "PyTorch", "SLAM", "LiDAR", "Point Cloud", "AMR", "Localization"],
    repo: "https://github.com/kimjiil/PointLoc",
  },
  {
    period: "2020. 08 ~ 2023. 01",
    duration: "2년 5개월",
    name: "펨트론",
    role: "AOI AI팀 개발자",
    desc: "AOI(Automated Optical Inspection) 장비 개발 업체 (AI 개발팀 4명)",
    items: [
      "검사 장비에 들어가는 AI 모델 개발",
      "기존 소프트웨어에서 AI 모델을 사용할 수 있는 API(Pembrain) 개발",
      "AI OCR 알고리즘 기능 개발 및 모델 배포",
    ],
    keywords: ["C++", "Libtorch", "Python", "PyTorch", "CUDA", "Object Detection", "OpenCV", "OCR"],
  },
  {
    period: "2018. 01 ~ 2020. 07",
    duration: "2년 6개월",
    name: "DataMining Lab",
    role: "연구원 (prof. Cheong Hee Park)",
    desc: "XAI(explainable AI) AD 기반 스마트 에너지 플랫폼 기술 개발, 한국전력연구원 과제 참여",
    items: [
      "이상치 탐지 및 이상 패턴 탐지에 관한 기술 연구",
      "지중 케이블에서 부분 방전(Partial Discharge) 탐지에 관한 연구",
    ],
    keywords: ["MatLab", "Java", "Python", "TensorFlow", "Outlier Detection", "Pattern Detection", "DataMining"],
  },
  {
    period: "2016. 12 ~ 2017. 12",
    duration: "12개월",
    name: "CV Lab Intern",
    role: "보조 연구원 (prof. Dong Bo Min)",
    desc: "딥러닝 기반 단일 컬러 영상에서 손동작 인식 졸업 프로젝트 수행 (2명)",
    items: [
      "Stereo Camera로 Hand Pose Dataset, City Space Dataset 수집 및 라벨링",
      "Hand Pose Estimation에 관한 논문 리서치 및 연구",
    ],
    keywords: ["Python", "TensorFlow", "OpenCV", "Arduino", "DeepLearning", "HCI"],
  },
];

const projects = [
  {
    period: "2023. 12 ~ 2024. 05",
    name: "딥러닝 기반 SLAM/Localization (PointLoc)",
    org: "시스윈 로보틱스",
    items: [
      "AMR에 적용할 딥러닝 기반 SLAM/Localization 논문 리서치 및 연구",
      "LiDAR 포인트 클라우드에서 로봇의 6-DoF 포즈를 직접 회귀하는 PointLoc 모델 구현 및 학습·평가",
    ],
    repo: "https://github.com/kimjiil/PointLoc",
  },
  {
    period: "2022. 05 ~ 2023. 01",
    name: "Chip Counter",
    org: "펨트론",
    items: [
      "X-ray SMD counter 장비인 Mercury에 들어가는 AI 모델 개발 보조",
      "chip counter 관련 알고리즘 딥러닝 기술 논문 리서치 및 모델 테스트",
    ],
  },
  {
    period: "2020. 08 ~ 2022. 04",
    name: "AI OCR",
    org: "펨트론",
    items: [
      "OCR 관련 딥러닝 논문 리서치 및 연구, 모델 테스트",
      "AI 모델을 회사 소프트웨어에서 사용할 수 있도록 하는 API인 PemBrain 개발(OCR 부분)",
      "AI OCR 기능 유지 및 보수, OCR Dataset 수집 및 관리, 딥러닝 모델 배포",
      "Object Detection 기반 AI OCR 모델 기술(Auto Teaching) 개발 및 배포",
      "AI OCR 모델 최적화(TensorRT) 및 경량화, 기존 이미지 전처리 알고리즘 C++을 CUDA로 변환",
    ],
  },
  {
    period: "2018. 01 ~ 2020. 07",
    name: "XAI(eXplainable AI) AD 기반 스마트 에너지 플랫폼 기술 개발",
    org: "한국전력연구원(KEPRI)",
    items: [
      "이상치 탐지 및 이상 패턴 탐지에 관한 기술 연구",
      "스트리밍 전력 설비 데이터에 대한 고장 및 이상 탐지에 트리, 클러스터링 기반 앙상블 모델을 적용",
      "실제 전력 설비 데이터인 지중 케이블에서 발생하는 부분 방전(Partial Discharge)을 탐지하는 모델 적용",
      "이상치 탐지 관련 특허 및 관련 논문 작성",
    ],
  },
  {
    period: "2016. 12 ~ 2017. 12",
    name: "딥러닝 기반 단일 컬러 영상에서 손동작 인식",
    org: "CNU CVLab",
    items: [
      "Hand skeleton Estimation 관련 논문 리서치 및 모델 테스트",
      "웹캠으로 촬영한 실시간 영상을 통해 딥러닝으로 3d points를 추론하는 모델 학습",
      "3d points를 통해 로봇 손을 움직이는 알고리즘 개발",
      "딥러닝 모델과 아두이노 보드 통신 연결 및 로봇 손 제어",
    ],
  },
];

const publications = [
  {
    date: "2020. 10",
    title: "Partial Discharge Detection Based on Anomaly Pattern Detection",
    detail: "Energies 2020. Kim J, Park CH",
  },
  {
    date: "2020. 7",
    title: "An explainable outlier detection method using region-partition trees",
    detail: "The Journal of Supercomputing 2021. Cheong Hee Park, Jiil Kim",
  },
  {
    date: "2018. 12",
    title: "트리 기반 앙상블 모델 구성을 이용한 이상치 탐지",
    detail: "한국정보학회 한국소프트웨어종합학술대회 2018. 김지일, 김태공, 박정희",
  },
  {
    date: "2018. 12",
    title: "스트리밍 데이터에서 이상 패턴 탐지",
    detail: "한국정보학회 한국소프트웨어종합학술대회 2018. 김태공, 김지일, 박정희",
  },
  {
    date: "2018. 9",
    title: "Outlier Detection By Clustering-Based Ensemble Model Construction",
    detail: "KIPS Transactions on Software and Data Engineering 2018. 박정희, 김태공, 김지일, 최세목, 이경훈",
  },
];

const education = [
  { period: "2018. 09 ~ 2020. 08", name: "충남대학교 대학원 졸업", detail: "멀티미디어 및 시스템 석사 전공, 데이터마이닝 랩실" },
  { period: "2013. 03 ~ 2018. 08", name: "충남대학교 졸업", detail: "컴퓨터공학과 학사 전공" },
];

const awards = [
  { date: "2017. 12", name: "충남대 컴퓨터공학과 창의경진대회 대상", detail: "딥러닝 기반 일반 카메라 영상에서 손동작을 인식해서 로봇 손을 움직이는 졸업 프로젝트" },
  { date: "2017. 12", name: "충남대 국방ICT 종합학술대회 포스터발표 특별상", detail: "충남대 정보통신과, 컴퓨터공학과 포스터 발표대회" },
];
---

<BaseLayout title="About" description="김지일(Jiil Kim) — AI/ML 엔지니어">
  <div class="container page-main about">
    <!-- Profile -->
    <header class="profile">
      <h1 class="page-title"><span class="prompt">$</span>whoami</h1>
      <div class="profile-card">
        <p class="name">김지일 <span class="en">Jiil Kim</span></p>
        <ul class="contacts mono">
          <li><span class="k">email:</span> <a href={"mailto:" + EMAIL}>{EMAIL}</a></li>
          <li><span class="k">github:</span> <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">{GITHUB_URL}</a></li>
          <li><span class="k">blog:</span> <a href="/">https://kimjiil.github.io</a></li>
        </ul>
        <p class="notice">휴대전화가 아닌 <strong>이메일</strong>로 연락 부탁드립니다.</p>
      </div>
    </header>

    <!-- Skills -->
    <section class="about-section">
      <h2 class="section-title"><span class="prompt">$</span>cat skills.json</h2>
      <div class="skills-grid">
        {
          Object.entries(skills).map(([group, list]) => (
            <div class="skill-group">
              <h3 class="skill-group-title mono">{group}</h3>
              <div class="skill-tags">
                {list.map((s) => (
                  <span class="tag">{s}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Experience -->
    <section class="about-section">
      <h2 class="section-title"><span class="prompt">$</span>history --experience</h2>
      <div class="timeline">
        {
          experiences.map((e) => (
            <div class="timeline-item">
              <div class="tl-period mono">
                {e.period}
                <span class="dur">{e.duration}</span>
              </div>
              <div class="tl-body">
                <h3 class="tl-name">{e.name}</h3>
                <p class="tl-role">{e.role}</p>
                <p class="tl-desc">{e.desc}</p>
                <ul>
                  {e.items.map((it) => (
                    <li>{it}</li>
                  ))}
                </ul>
                {
                  "repo" in e && (
                    <a class="repo-link mono" href={e.repo} target="_blank" rel="noopener noreferrer">
                      ↗ {e.repo}
                    </a>
                  )
                }
                <div class="skill-tags">
                  {e.keywords.map((k) => (
                    <span class="tag">{k}</span>
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Projects -->
    <section class="about-section">
      <h2 class="section-title"><span class="prompt">$</span>ls ./projects --history</h2>
      <div class="timeline">
        {
          projects.map((p) => (
            <div class="timeline-item">
              <div class="tl-period mono">{p.period}</div>
              <div class="tl-body">
                <h3 class="tl-name">{p.name}</h3>
                <p class="tl-role">{p.org}</p>
                <ul>
                  {p.items.map((it) => (
                    <li>{it}</li>
                  ))}
                </ul>
                {
                  "repo" in p && (
                    <a class="repo-link mono" href={p.repo} target="_blank" rel="noopener noreferrer">
                      ↗ {p.repo}
                    </a>
                  )
                }
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Publication -->
    <section class="about-section">
      <h2 class="section-title"><span class="prompt">$</span>cat publications.bib</h2>
      <div class="pub-list">
        {
          publications.map((p) => (
            <div class="pub-item">
              <span class="pub-date mono">{p.date}</span>
              <div>
                <p class="pub-title">{p.title}</p>
                <p class="pub-detail">{p.detail}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Education -->
    <section class="about-section">
      <h2 class="section-title"><span class="prompt">$</span>cat education.log</h2>
      <div class="timeline">
        {
          education.map((e) => (
            <div class="timeline-item">
              <div class="tl-period mono">{e.period}</div>
              <div class="tl-body">
                <h3 class="tl-name">{e.name}</h3>
                <p class="tl-desc">{e.detail}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Awards / Etc -->
    <section class="about-section">
      <h2 class="section-title"><span class="prompt">$</span>ls ./awards</h2>
      <div class="pub-list">
        {
          awards.map((a) => (
            <div class="pub-item">
              <span class="pub-date mono">{a.date}</span>
              <div>
                <p class="pub-title">{a.name}</p>
                <p class="pub-detail">{a.detail}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about {
    max-width: 900px;
  }

  .profile-card {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-xl);
    padding: 2rem;
  }

  .name {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 1rem;
  }

  .name .en {
    font-size: 1rem;
    font-weight: 400;
    color: var(--color-text-muted);
    margin-left: 0.5rem;
  }

  .contacts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.9rem;
  }

  .contacts .k {
    color: var(--color-green);
    margin-right: 0.4rem;
  }

  .notice {
    margin: 1.2rem 0 0;
    padding: 0.7rem 1rem;
    background: var(--color-accent-light);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    font-size: 0.88rem;
  }

  .about-section {
    margin-top: 3.5rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .skill-group {
    background: var(--color-surface);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
  }

  .skill-group-title {
    color: var(--color-accent);
    font-size: 0.9rem;
    margin: 0 0 0.8rem;
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  /* Timeline */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    margin-top: 1.25rem;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 1.5rem;
    padding: 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
  }

  .tl-period {
    color: var(--color-accent);
    font-size: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .tl-period .dur {
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }

  .tl-name {
    color: var(--color-text-primary);
    font-size: 1.1rem;
    margin: 0 0 0.25rem;
  }

  .tl-role {
    color: var(--color-green);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    margin: 0 0 0.5rem;
  }

  .tl-desc {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin: 0 0 0.5rem;
  }

  .tl-body ul {
    margin: 0.5rem 0 0.9rem;
    padding-left: 1.2rem;
    font-size: 0.92rem;
  }

  .tl-body li {
    margin: 0.3rem 0;
  }

  .tl-body li::marker {
    color: var(--color-accent);
  }

  .repo-link {
    display: inline-block;
    margin-bottom: 0.9rem;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    padding: 0.25rem 0.7rem;
  }

  .repo-link:hover {
    color: var(--color-accent);
    border-color: var(--color-border-hover);
  }

  /* Publications */
  .pub-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .pub-item {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 1.25rem;
    padding: 1.1rem 1.4rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
  }

  .pub-date {
    color: var(--color-accent);
    font-size: 0.82rem;
  }

  .pub-title {
    color: var(--color-text-primary);
    font-weight: 600;
    margin: 0 0 0.25rem;
    font-size: 0.98rem;
  }

  .pub-detail {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    margin: 0;
  }

  @media (max-width: 768px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }

    .timeline-item,
    .pub-item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
