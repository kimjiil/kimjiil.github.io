---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import DeskScene from "../components/DeskScene.astro";
import { SECTIONS } from "../consts";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const bySection = (section: string) => posts.filter((p) => p.id.startsWith(section + "/"));

const previews = [
  { key: "papers", posts: bySection("papers").slice(0, 4) },
  { key: "study", posts: bySection("study").slice(0, 4) },
  { key: "projects", posts: bySection("projects").slice(0, 4) },
];
---

<BaseLayout>
  <!-- Hero: 인터랙티브 데스크 (모니터 화면에서 인트로 애니메이션 재생) -->
  <DeskScene />

  <!-- Section Previews -->
  <div class="container home-sections">
    {
      previews.map(({ key, posts: sectionPosts }) => (
        <section class="home-section">
          <div class="home-section-head">
            <h2 class="section-title">
              <span class="prompt">$</span>ls ./{key}
            </h2>
            <a href={`/${key}`} class="more-link mono">
              cd /{key} →
            </a>
          </div>
          <p class="section-sub">{SECTIONS[key]!.desc}</p>
          {sectionPosts.length > 0 ? (
            <div class="card-grid">
              {sectionPosts.map((post) => (
                <PostCard post={post} />
              ))}
            </div>
          ) : (
            <p class="empty mono">// 아직 작성된 글이 없습니다</p>
          )}
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  /* ===== Home sections ===== */
  .home-sections {
    padding: 3rem 1.5rem 5rem;
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .home-section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .more-link {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .more-link:hover {
    color: var(--color-accent);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .empty {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  @media (max-width: 768px) {
    .card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
