---
import { SITE_DESC, GITHUB_URL, EMAIL } from "../consts";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <!-- Brand -->
      <div class="footer-brand">
        <a href="/" class="logo-text">kimjiil.github.io</a>
        <p class="tagline">{SITE_DESC}</p>
      </div>

      <!-- Links -->
      <div class="footer-links">
        <h4 class="footer-title">Links</h4>
        <ul>
          <li><a href="/papers">Paper Review</a></li>
          <li><a href="/study">Study</a></li>
          <li><a href="/projects">Projects</a></li>
          <li><a href="/tags">Tags</a></li>
          <li><a href="/about">About</a></li>
        </ul>
      </div>

      <!-- Social -->
      <div class="footer-social">
        <h4 class="footer-title">Connect</h4>
        <div class="social-icons">
          <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="social-link">
            <svg class="icon" fill="currentColor" viewBox="0 0 24 24" width="18" height="18">
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
              ></path>
            </svg>
            <span>GitHub</span>
          </a>
          <a href={"mailto:" + EMAIL} aria-label="Email" class="social-link">
            <svg class="icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="18" height="18">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            <span>Email</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Copyright -->
    <div class="footer-bottom">
      <p>&copy; {year} Jiil Kim. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
    background: var(--color-bg-secondary);
    border-top: 1px solid var(--color-border-light);
    padding: 3rem 0 1.5rem;
  }

  .footer-content {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 2rem;
  }

  .logo-text {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .tagline {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin: 0.75rem 0 0;
  }

  .footer-title {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-primary);
    margin: 0 0 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .footer-links ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .footer-links a {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .footer-links a:hover {
    color: var(--color-accent);
  }

  .social-icons {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .social-link:hover {
    color: var(--color-accent);
  }

  .footer-bottom {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border-light);
    text-align: center;
  }

  .footer-bottom p {
    color: var(--color-text-muted);
    font-size: 0.82rem;
    font-family: var(--font-mono);
    margin: 0;
  }

  @media (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr;
    }
  }
</style>
