---
import { getCollection } from "astro:content";
import PostCard from "./PostCard.astro";
import { CATEGORIES, SECTIONS } from "../consts";

interface Props {
  section: string;
  activeCat?: string;
}

const { section, activeCat } = Astro.props;
const info = SECTIONS[section]!;

const allPosts = (await getCollection("posts", ({ data }) => !data.draft))
  .filter((p) => p.id.startsWith(section + "/"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const posts = activeCat ? allPosts.filter((p) => p.data.category === activeCat) : allPosts;

const cats = Object.entries(CATEGORIES)
  .filter(([, v]) => v.section === section)
  .map(([key, v]) => ({
    key,
    label: v.label,
    count: allPosts.filter((p) => p.data.category === key).length,
  }));

const activeLabel = activeCat ? CATEGORIES[activeCat]?.label : undefined;
---

<div class="container page-main">
  <header class="page-header">
    <h1 class="page-title">
      <span class="prompt">$</span>ls ./{section}{activeLabel ? `/${activeLabel}` : ""}
    </h1>
    <p class="page-desc">{info.desc}</p>
  </header>

  <!-- Category filter chips (링크) -->
  <div class="filter-chips">
    <a href={`/${section}`} class:list={["chip", { active: !activeCat }]}>
      All <span class="count">{allPosts.length}</span>
    </a>
    {
      cats.map((c) => (
        <a href={`/${section}/${c.key}`} class:list={["chip", { active: activeCat === c.key }]}>
          {c.label} <span class="count">{c.count}</span>
        </a>
      ))
    }
  </div>

  {
    posts.length > 0 ? (
      <div class="list-grid">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    ) : (
      <p class="empty mono">// 아직 작성된 글이 없습니다. 곧 추가될 예정입니다.</p>
    )
  }
</div>

<style>
  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .chip {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    background: var(--color-bg-tertiary);
    border: 1px solid var(--color-border-light);
    color: var(--color-text-muted);
    cursor: pointer;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      background var(--transition-fast);
  }

  .chip:hover {
    color: var(--color-text-primary);
    border-color: var(--color-border-hover);
  }

  .chip.active {
    color: var(--color-accent);
    background: var(--color-accent-light);
    border-color: var(--color-border);
  }

  .chip .count {
    opacity: 0.6;
    margin-left: 0.2rem;
  }

  .list-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .empty {
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .list-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
